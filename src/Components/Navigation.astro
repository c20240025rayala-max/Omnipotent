---
const links = [
	{ label: "Home", href: "/" },
	{ label: "About", href: "/about/" },
	{ label: "Services", href: "/services/" },
	{ label: "Process", href: "/process/" },
	{ label: "Work", href: "/projects/" },
	{ label: "Contact", href: "/contact/" },
];
const currentPath = Astro.url.pathname;
---

<nav class="nav container" aria-label="Main navigation">
	<a class="brand" href="/" aria-label="Omnipotent home">
		<img class="brand-mark" src="/omnipotent-logo.png" alt="" />
		<span>Omnipotent</span>
	</a>
	<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
		Menu <span aria-hidden="true">+</span>
	</button>
	<div class="nav-links" id="primary-navigation">
		{links.map(({ label, href }) => (
			<a href={href} aria-current={currentPath === href ? "page" : undefined}>{label}</a>
		))}
		<a class="nav-cta" href="/contact/" aria-current={currentPath === "/contact/" ? "page" : undefined}>Let's talk</a>
	</div>
</nav>

<script>
	import { gsap } from "gsap";

	const nav = document.querySelector(".nav");
	const menuToggle = nav?.querySelector<HTMLButtonElement>(".menu-toggle");
	const navLinks = nav?.querySelector<HTMLDivElement>(".nav-links");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	menuToggle?.addEventListener("click", () => {
		const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
		menuToggle.setAttribute("aria-expanded", String(!isExpanded));
		if (!navLinks) return;

		if (!isExpanded) {
			navLinks.classList.add("is-open");
			if (reduceMotion) {
				gsap.set(navLinks, { clearProps: "all" });
			} else {
				gsap.fromTo(navLinks, { autoAlpha: 0, y: -8 }, { autoAlpha: 1, y: 0, duration: 0.24, ease: "power2.out" });
			}
		} else {
			if (reduceMotion) {
				navLinks.classList.remove("is-open");
				gsap.set(navLinks, { clearProps: "all" });
			} else {
				gsap.to(navLinks, {
					autoAlpha: 0,
					y: -8,
					duration: 0.18,
					ease: "power2.in",
					onComplete: () => navLinks.classList.remove("is-open"),
				});
			}
		}
	});

	navLinks?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			menuToggle?.setAttribute("aria-expanded", "false");
			navLinks.classList.remove("is-open");
		});
	});

	window.addEventListener("resize", () => {
		if (window.innerWidth > 900) {
			menuToggle?.setAttribute("aria-expanded", "false");
			navLinks?.classList.remove("is-open");
			if (navLinks) gsap.set(navLinks, { clearProps: "all" });
		}
	});
</script>

<style>
	.nav { position: sticky; z-index: 20; top: 12px; display: flex; height: 76px; align-items: center; justify-content: space-between; margin-block: 12px; padding: 0 24px; border: 1px solid var(--line); border-radius: 18px; background: rgba(8,9,13,.78); backdrop-filter: blur(18px); }
	.brand { display: inline-flex; align-items: center; gap: 10px; font-size: 1.12rem; font-weight: 760; letter-spacing: -.045em; }
	.brand-mark { width: 38px; height: 38px; border-radius: 11px; object-fit: cover; }
	.nav-links { display: flex; align-items: center; gap: 22px; font-size: .82rem; font-weight: 600; }
	.nav-links a:not(.nav-cta) { position: relative; padding-block: 8px; color: #cbd5e1; }
	.nav-links a:not(.nav-cta)::after { position: absolute; right: 0; bottom: 2px; left: 0; height: 1px; content: ""; background: var(--cyan); transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
	.nav-links a:not(.nav-cta):hover::after,.nav-links a[aria-current="page"]::after { transform: scaleX(1); }
	.nav-links a:hover,.nav-links a[aria-current="page"]:not(.nav-cta) { color: white; }
	.nav-cta { padding: 11px 16px; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; color: white; background: rgba(255,255,255,.08); }
	.nav-links .nav-cta:hover,.nav-links .nav-cta[aria-current="page"] { color: #08090d; background: var(--cyan); border-color: var(--cyan); }
	.menu-toggle { display: none; align-items: center; gap: 10px; border: 1px solid var(--line); border-radius: 999px; padding: 10px 14px; color: var(--ink); background: transparent; font-size: .86rem; font-weight: 700; cursor: pointer; }
	.menu-toggle span { font-size: 1.1rem; line-height: 1; }
	@media (max-width: 900px) {
		.nav { padding-inline: 18px; }
		.menu-toggle { display: inline-flex; }
		.nav-links { position: absolute; top: calc(100% + 8px); right: 0; left: 0; display: flex; visibility: hidden; flex-direction: column; align-items: stretch; gap: 2px; padding: 12px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); box-shadow: 0 18px 48px rgba(0,0,0,.4); opacity: 0; pointer-events: none; }
		.nav-links.is-open { visibility: visible; opacity: 1; pointer-events: auto; }
		.nav-links a { padding: 12px; }
		.nav-links .nav-cta { margin-top: 6px; text-align: center; }
	}
	@media (max-width: 520px) {
		.nav { height: 68px; }
	}
</style>
