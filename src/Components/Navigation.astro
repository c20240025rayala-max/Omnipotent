---
const links = [
	{ label: "Home", href: "/" },
	{ label: "About", href: "/about/" },
	{ label: "Services", href: "/services/" },
	{ label: "Process", href: "/process/" },
	{ label: "Work", href: "/projects/" },
	{ label: "Contact", href: "/contact/" },
];
const currentPath = Astro.url.pathname;
---

<nav class="nav container" aria-label="Main navigation">
	<a class="brand" href="/" aria-label="Omnipotent home">
		<img class="brand-mark" src="/omnipotent-logo.png" alt="" />
		<span>Omnipotent</span>
	</a>
	<div class="nav-links" id="primary-navigation">
		{links.map(({ label, href }) => (
			<a href={href} aria-current={currentPath === href ? "page" : undefined}>{label}</a>
		))}
		<a class="nav-cta" href="/contact/" aria-current={currentPath === "/contact/" ? "page" : undefined}>Let's talk</a>
	</div>
	<div class="nav-controls">
		<button class="theme-toggle" type="button" aria-label="Switch to light theme" aria-pressed="false" title="Switch to light theme">
			<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
			<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"></path></svg>
		</button>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
			Menu <span aria-hidden="true">+</span>
		</button>
	</div>
</nav>

<script>
	import { gsap } from "gsap";

	const nav = document.querySelector(".nav");
	const menuToggle = nav?.querySelector<HTMLButtonElement>(".menu-toggle");
	const themeToggle = nav?.querySelector<HTMLButtonElement>(".theme-toggle");
	const navLinks = nav?.querySelector<HTMLDivElement>(".nav-links");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const updateThemeToggle = () => {
		const isLight = document.documentElement.dataset.theme === "light";
		themeToggle?.setAttribute("aria-pressed", String(isLight));
		themeToggle?.setAttribute("aria-label", `Switch to ${isLight ? "dark" : "light"} theme`);
		themeToggle?.setAttribute("title", `Switch to ${isLight ? "dark" : "light"} theme`);
	};

	updateThemeToggle();
	themeToggle?.addEventListener("click", () => {
		const nextTheme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
		document.documentElement.dataset.theme = nextTheme;
		localStorage.setItem("omnipotent-theme", nextTheme);
		updateThemeToggle();
	});

	menuToggle?.addEventListener("click", () => {
		const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
		menuToggle.setAttribute("aria-expanded", String(!isExpanded));
		if (!navLinks) return;

		if (!isExpanded) {
			navLinks.classList.add("is-open");
			if (reduceMotion) {
				gsap.set(navLinks, { clearProps: "all" });
			} else {
				gsap.fromTo(navLinks, { autoAlpha: 0, y: -8 }, { autoAlpha: 1, y: 0, duration: 0.24, ease: "power2.out" });
			}
		} else {
			if (reduceMotion) {
				navLinks.classList.remove("is-open");
				gsap.set(navLinks, { clearProps: "all" });
			} else {
				gsap.to(navLinks, {
					autoAlpha: 0,
					y: -8,
					duration: 0.18,
					ease: "power2.in",
					onComplete: () => navLinks.classList.remove("is-open"),
				});
			}
		}
	});

	navLinks?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			menuToggle?.setAttribute("aria-expanded", "false");
			navLinks.classList.remove("is-open");
		});
	});

	window.addEventListener("resize", () => {
		if (window.innerWidth > 900) {
			menuToggle?.setAttribute("aria-expanded", "false");
			navLinks?.classList.remove("is-open");
			if (navLinks) gsap.set(navLinks, { clearProps: "all" });
		}
	});
</script>

<style>
	.nav { position: sticky; z-index: 20; top: 12px; display: flex; height: 76px; align-items: center; justify-content: space-between; margin-block: 12px; padding: 0 24px; border: 1px solid var(--line); border-radius: 18px; background: var(--nav-glass); backdrop-filter: blur(18px); }
	.brand { display: inline-flex; align-items: center; gap: 10px; font-size: 1.12rem; font-weight: 760; letter-spacing: -.045em; }
	.brand-mark { width: 38px; height: 38px; border-radius: 11px; object-fit: cover; }
	.nav-controls { display: flex; align-items: center; gap: 10px; }
	.nav-links { display: flex; align-items: center; gap: 22px; font-size: .82rem; font-weight: 600; }
	.nav-links a:not(.nav-cta) { position: relative; padding-block: 8px; color: var(--muted); }
	.nav-links a:not(.nav-cta)::after { position: absolute; right: 0; bottom: 2px; left: 0; height: 1px; content: ""; background: var(--cyan); transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
	.nav-links a:not(.nav-cta):hover::after,.nav-links a[aria-current="page"]::after { transform: scaleX(1); }
	.nav-links a:hover,.nav-links a[aria-current="page"]:not(.nav-cta) { color: var(--ink); }
	.nav-cta { padding: 11px 16px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); background: var(--card); }
	.nav-links .nav-cta:hover,.nav-links .nav-cta[aria-current="page"] { color: #08090d; background: var(--cyan); border-color: var(--cyan); }
	.theme-toggle,.menu-toggle { display: inline-flex; width: 40px; height: 40px; flex: none; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); background: var(--card); cursor: pointer; transition: border-color 180ms ease, background 180ms ease, transform 180ms ease; }
	.theme-toggle:hover,.menu-toggle:hover { transform: translateY(-1px); border-color: var(--accent); background: var(--raised); }
	.theme-toggle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
	.moon-icon { display: none; }
	:global(html[data-theme="light"]) .sun-icon { display: none; }
	:global(html[data-theme="light"]) .moon-icon { display: block; }
	.menu-toggle { display: none; width: auto; height: auto; gap: 10px; border-radius: 999px; padding: 10px 14px; font-size: .86rem; font-weight: 700; }
	.menu-toggle span { font-size: 1.1rem; line-height: 1; }
	@media (max-width: 900px) {
		.nav { padding-inline: 18px; }
		.menu-toggle { display: inline-flex; }
		.nav-links { position: absolute; top: calc(100% + 8px); right: 0; left: 0; display: flex; visibility: hidden; flex-direction: column; align-items: stretch; gap: 2px; padding: 12px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); box-shadow: 0 18px 48px rgba(0,0,0,.2); opacity: 0; pointer-events: none; }
		.nav-links.is-open { visibility: visible; opacity: 1; pointer-events: auto; }
		.nav-links a { padding: 12px; }
		.nav-links .nav-cta { margin-top: 6px; text-align: center; }
	}
	@media (max-width: 520px) {
		.nav { height: 68px; }
	}
</style>
