---
const team = [
	{
		index: "Creator 01",
		name: "Reden Rayala",
		role: "Web Developer",
		introduction:
			"Passionate about building modern, responsive, and high-performing websites. Focused on transforming creative ideas into functional digital experiences through clean code and innovative technologies.",
		image: "/reden-rayala.webp",
		alt: "Reden Rayala, Web Developer, wearing black formal attire",
		className: "reden",
		accent: "cyan",
	},
	{
		index: "Creator 02",
		name: "Queen Rosemher Dumali",
		role: "Creative Partner / Web Design Collaborator",
		introduction:
			"Passionate about creating meaningful digital experiences through creativity, thoughtful design, and user-centered visual solutions.",
		image: "/queen-rosemher-dumali.webp",
		alt: "Queen Rosemher Dumali, Creative Partner and Web Design Collaborator, wearing black formal attire",
		className: "queen",
		accent: "violet",
	},
];
---

<section class="about-team" id="about">
	<div class="container">
		<header class="team-heading">
			<p class="eyebrow">The people behind Omnipotent</p>
			<h2>Meet the Minds Behind Omnipotent</h2>
			<p class="heading-description">A creative team combining technology, innovation, and design to build meaningful digital experiences.</p>
		</header>

		<div class="team-grid">
			{team.map((member) => (
				<article class:list={["profile-card", member.className]}>
					<div class="profile-visual" data-profile-visual>
						<div class="visual-grid" aria-hidden="true"></div>
						<div class="visual-glow" aria-hidden="true"></div>
						<div class="visual-ring ring-one" aria-hidden="true"></div>
						<div class="visual-ring ring-two" aria-hidden="true"></div>
						<div class="portrait-frame" data-parallax>
							<img src={member.image} alt={member.alt} width="900" height="1200" loading="lazy" />
							<div class="portrait-sheen" aria-hidden="true"></div>
						</div>
						<div class="visual-status" aria-hidden="true"><i></i>{member.accent === "cyan" ? "Development" : "Creative"}</div>
						<div class="creator-mark" aria-hidden="true">{member.index.replace("Creator ", "")}</div>
					</div>
					<div class="profile-content">
						<p class="member-index">{member.index}</p>
						<h3>{member.name}</h3>
						<p class="member-role">{member.role}</p>
						<p class="member-introduction">{member.introduction}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	document.querySelectorAll<HTMLElement>(".about-team").forEach((section) => {
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const context = gsap.context(() => {
			if (reduceMotion) return;

			gsap.from(".team-heading", {
				y: 24,
				autoAlpha: 0,
				duration: 0.75,
				ease: "power3.out",
				scrollTrigger: { trigger: ".team-heading", start: "top 82%", once: true },
			});

			gsap.utils.toArray<HTMLElement>(".profile-card").forEach((card, index) => {
				gsap.timeline({
					scrollTrigger: { trigger: card, start: "top 86%", once: true },
				})
					.from(card, { y: 36, autoAlpha: 0, duration: 0.75, ease: "power3.out" })
					.from(card.querySelector(".portrait-frame"), { clipPath: "inset(12% 12% 12% 12% round 22px)", scale: 1.08, duration: 0.9, ease: "power3.out" }, "-=0.45")
					.from(card.querySelectorAll(".profile-content > *"), { y: 14, autoAlpha: 0, duration: 0.45, stagger: 0.08, ease: "power2.out" }, "-=0.42");

				const frame = card.querySelector<HTMLElement>(".portrait-frame");
				const visual = card.querySelector<HTMLElement>(".profile-visual");

				card.addEventListener("pointermove", (event) => {
					if (event.pointerType === "touch") return;
					const rect = card.getBoundingClientRect();
					const x = (event.clientX - rect.left) / rect.width - 0.5;
					const y = (event.clientY - rect.top) / rect.height - 0.5;
					gsap.to(card, { rotateY: x * 5, rotateX: y * -4, duration: 0.55, ease: "power2.out", transformPerspective: 1100 });
					if (frame) gsap.to(frame, { x: x * 10, y: y * 8, duration: 0.55, ease: "power2.out" });
					if (visual) gsap.to(visual, { backgroundPosition: `${50 + x * 8}% ${50 + y * 8}%`, duration: 0.55, ease: "power2.out" });
				});

				card.addEventListener("pointerleave", () => {
					gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.7, ease: "power3.out" });
					if (frame) gsap.to(frame, { x: 0, y: 0, duration: 0.7, ease: "power3.out" });
				});

				if (frame) {
					gsap.to(frame, {
						y: index % 2 === 0 ? -7 : 7,
						duration: index % 2 === 0 ? 3.8 : 4.2,
						repeat: -1,
						yoyo: true,
						ease: "sine.inOut",
					});
				}
			});
		}, section);

		document.addEventListener("astro:before-swap", () => context.revert(), { once: true });
	});
</script>

<style>
	.about-team { position: relative; overflow: hidden; padding: 104px 0 116px; background: var(--paper); color: var(--ink); }
	.about-team::before { position: absolute; top: 0; left: 50%; width: min(950px, 100%); height: 1px; content: ""; background: linear-gradient(90deg, transparent, rgba(167,139,250,.34), transparent); transform: translateX(-50%); }
	.team-heading { max-width: 820px; margin: 0 auto 62px; text-align: center; }
	.about-team :global(.eyebrow) { margin-bottom: 20px; color: var(--accent); }
	.team-heading h2 { max-width: 760px; margin: 0 auto; font-size: clamp(3rem, 6.4vw, 5.8rem); font-weight: 720; line-height: 1; letter-spacing: -.075em; }
	.heading-description { max-width: 680px; margin: 22px auto 0; color: var(--muted); font-size: 1rem; line-height: 1.8; }
	.team-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; perspective: 1100px; }
	.profile-card { min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 22px; background: var(--card); box-shadow: 0 24px 70px rgba(0,0,0,.12); transform-style: preserve-3d; transition: border-color 220ms ease, box-shadow 220ms ease; }
	.profile-card.queen { margin-top: 36px; }
	.profile-card:hover { border-color: rgba(34,211,238,.38); box-shadow: 0 28px 80px rgba(34,211,238,.10), 0 24px 70px rgba(0,0,0,.18); }
	.profile-card.queen:hover { border-color: rgba(167,139,250,.42); box-shadow: 0 28px 80px rgba(167,139,250,.12), 0 24px 70px rgba(0,0,0,.18); }
	.profile-visual { position: relative; height: clamp(430px, 38vw, 520px); overflow: hidden; isolation: isolate; background: radial-gradient(circle at 72% 38%, rgba(139,92,246,.24), transparent 34%), linear-gradient(145deg, rgba(17,19,26,.96), rgba(8,9,13,.96)); }
	.queen .profile-visual { background: radial-gradient(circle at 30% 38%, rgba(34,211,238,.20), transparent 34%), linear-gradient(145deg, rgba(13,18,22,.96), rgba(19,16,27,.96)); }
	.visual-grid { position: absolute; z-index: -1; inset: 0; opacity: .22; background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); background-size: 38px 38px; mask-image: radial-gradient(ellipse at center, black, transparent 78%); transform: perspective(500px) rotateX(8deg); }
	.visual-glow { position: absolute; z-index: -1; width: 290px; height: 290px; border-radius: 50%; background: radial-gradient(circle, rgba(139,92,246,.38), rgba(34,211,238,.08) 48%, transparent 72%); filter: blur(18px); top: 20%; left: 50%; transform: translateX(-50%); }
	.queen .visual-glow { background: radial-gradient(circle, rgba(34,211,238,.30), rgba(167,139,250,.12) 48%, transparent 72%); }
	.visual-ring { position: absolute; z-index: -1; top: 50%; left: 50%; width: 360px; height: 360px; border: 1px solid rgba(167,139,250,.30); border-radius: 50%; transform: translate(-50%, -50%) rotate(-24deg) scaleX(.72); }
	.ring-two { width: 420px; height: 420px; border-color: rgba(34,211,238,.18); border-style: dashed; transform: translate(-50%, -50%) rotate(38deg) scaleX(.74); }
	.queen .ring-one { border-color: rgba(34,211,238,.28); }
	.queen .ring-two { border-color: rgba(167,139,250,.22); }
	.portrait-frame { position: absolute; z-index: 2; right: 50%; bottom: 0; width: min(74%, 390px); height: calc(100% - 30px); overflow: hidden; border: 1px solid rgba(255,255,255,.16); border-radius: 180px 180px 20px 20px; background: rgba(255,255,255,.04); box-shadow: 0 30px 70px rgba(0,0,0,.38), inset 0 1px rgba(255,255,255,.14); transform: translateX(50%); transform-style: preserve-3d; will-change: transform; }
	.portrait-frame img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: 50% 18%; filter: saturate(.78) contrast(1.04); transition: filter 300ms ease, transform 700ms cubic-bezier(.2,.8,.2,1); }
	.queen .portrait-frame img { object-position: 50% 20%; filter: saturate(.72) contrast(1.05); }
	.profile-card:hover .portrait-frame img { filter: saturate(.92) contrast(1.04); transform: scale(1.025); }
	.portrait-sheen { position: absolute; inset: 0; background: linear-gradient(118deg, transparent 32%, rgba(255,255,255,.08) 48%, transparent 60%); transform: translateX(-100%); transition: transform 900ms ease; pointer-events: none; }
	.profile-card:hover .portrait-sheen { transform: translateX(100%); }
	.visual-status { position: absolute; z-index: 3; right: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 8px; padding: 9px 12px; border: 1px solid rgba(255,255,255,.12); border-radius: 999px; color: #dfe7ef; background: rgba(8,9,13,.68); backdrop-filter: blur(12px); font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.visual-status i { width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 12px var(--cyan); }
	.queen .visual-status i { background: #a78bfa; box-shadow: 0 0 12px #a78bfa; }
	.creator-mark { position: absolute; z-index: 3; top: 18px; left: 18px; display: grid; width: 46px; height: 46px; place-items: center; border: 1px solid rgba(255,255,255,.14); border-radius: 50%; color: #d6def0; background: rgba(8,9,13,.46); backdrop-filter: blur(10px); font-size: .72rem; font-weight: 750; }
	.profile-content { min-height: 230px; padding: 26px 28px 30px; background: linear-gradient(180deg, rgba(255,255,255,.015), transparent); }
	.member-index { margin: 0 0 12px; color: var(--cyan); font-size: .66rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
	.queen .member-index { color: #b8a4f8; }
	.profile-content h3 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.45rem); font-weight: 680; line-height: 1.05; letter-spacing: -.055em; }
	.member-role { margin: 9px 0 0; color: var(--accent); font-size: .82rem; font-weight: 650; line-height: 1.5; }
	.member-introduction { margin: 18px 0 0; color: var(--muted); font-size: .88rem; line-height: 1.78; }
	@media (max-width: 900px) {
		.about-team { padding: 86px 0 94px; }
		.team-grid { gap: 16px; }
		.profile-visual { height: 390px; }
		.profile-content { min-height: 250px; padding-inline: 22px; }
	}
	@media (max-width: 640px) {
		.about-team { padding: 74px 0 82px; }
		.team-heading { margin-bottom: 38px; text-align: left; }
		.team-heading h2 { max-width: 420px; margin-inline: 0; font-size: clamp(2.7rem, 12vw, 4.1rem); }
		.heading-description { margin-inline: 0; font-size: .92rem; }
		.team-grid { grid-template-columns: 1fr; gap: 18px; }
		.profile-card.queen { margin-top: 0; }
		.profile-visual { height: clamp(390px, 118vw, 520px); }
		.portrait-frame { width: min(78%, 390px); }
		.profile-content { min-height: 0; padding: 23px 22px 27px; }
		.profile-content h3 { font-size: clamp(1.9rem, 8vw, 2.6rem); }
		.member-introduction { font-size: .86rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.profile-card,.portrait-frame,.portrait-frame img,.portrait-sheen { transition: none; }
	}
</style>
