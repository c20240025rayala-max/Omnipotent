---
import Card from "../Card.astro";

const services = [
	{
		number: "01",
		title: "Website development",
		description: "Fast, accessible websites that make a strong first impression and turn visitors into customers.",
		details: ["Business & corporate sites", "Campaign landing pages"],
	},
	{
		number: "02",
		title: "Custom web applications",
		description: "Purpose-built tools that simplify complex workflows and grow with your business.",
		details: ["Dashboards & portals", "Custom business software"],
	},
	{
		number: "03",
		title: "UI/UX design",
		description: "Clear, considered interfaces shaped around real people, real needs, and real use.",
		details: ["Research & wireframes", "Prototypes & design systems"],
	},
	{
		number: "04",
		title: "E-commerce",
		description: "Thoughtful storefronts and checkout journeys that make shopping easy and secure.",
		details: ["Storefront design", "Payments & integrations"],
	},
	{
		number: "05",
		title: "Performance & SEO",
		description: "A faster, more discoverable foundation built for people and search engines.",
		details: ["Core Web Vitals", "Technical SEO & accessibility"],
	},
	{
		number: "06",
		title: "Ongoing support",
		description: "Practical maintenance and improvements that keep your digital product healthy.",
		details: ["Updates & monitoring", "Continuous improvements"],
	},
];
---

<section class="services" id="services">
	<div class="container">
		<div class="section-heading" data-reveal>
			<div>
				<p class="eyebrow">Capabilities</p>
				<h2>What we do<br /><span>best.</span></h2>
			</div>
			<p>One focused team from first idea to ongoing improvement. Bring us a specific challenge or a blank page.</p>
		</div>
		<div class="service-grid" data-reveal-stagger>
			{services.map((service) => <Card variant="service" item={service} />)}
		</div>
		<div class="service-footnote" data-reveal>
			<p>Not sure what you need yet?</p>
			<a href="/contact/">Let's figure it out together <span aria-hidden="true">→</span></a>
		</div>
	</div>
</section>

<style>
	.services { padding: 110px 0; background: var(--surface); }
	.section-heading { display: grid; grid-template-columns: 1fr 370px; align-items: end; gap: 48px; margin-bottom: 48px; }
	h2 { margin: 0; font-size: clamp(3.2rem, 6vw, 5.4rem); line-height: .94; letter-spacing: -.075em; text-transform: uppercase; }
	h2 span { color: var(--accent); }
	.section-heading > p { margin: 0 0 8px; color: var(--muted); line-height: 1.8; }
	.service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
	article { min-height: 285px; padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); transition: transform 200ms ease, border-color 200ms ease, background 200ms ease; }
	article:hover { transform: translateY(-4px); border-color: rgba(167,139,250,.52); background: var(--raised); }
	.card-top { display: flex; align-items: center; justify-content: space-between; }
	.number { color: var(--cyan); font-size: .72rem; font-weight: 750; letter-spacing: .12em; }
	.arrow { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: #b6a7fa; transition: transform 200ms ease, background 200ms ease; }
	article:hover .arrow { transform: rotate(45deg); background: rgba(139,92,246,.18); }
	h3 { margin: 30px 0 10px; font-size: 1.17rem; letter-spacing: -.035em; text-transform: capitalize; }
	.description { min-height: 52px; margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.7; }
	ul { display: flex; flex-wrap: wrap; gap: 7px; margin: 18px 0 0; padding: 0; list-style: none; }
	li { padding: 6px 9px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); font-size: .66rem; }
	.service-footnote { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--line); }
	.service-footnote p { margin: 0; color: var(--muted); font-size: .84rem; }
	.service-footnote a { color: var(--accent); font-size: .84rem; font-weight: 700; }
	@media (max-width: 900px) {
		.services { padding: 82px 0; }
		.section-heading { grid-template-columns: 1fr; gap: 22px; }
		.service-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 600px) {
		.service-grid { grid-template-columns: 1fr; }
		article { min-height: 0; }
		.description { min-height: 0; }
		.service-footnote { align-items: flex-start; flex-direction: column; }
	}
</style>
