---
const principles = [
	["01", "Modern by default", "Current tools and proven patterns, chosen to suit the job and your team."],
	["02", "Built to last", "Readable, maintainable code that can grow without becoming a burden."],
	["03", "Responsive first", "Thoughtful experiences that work across screens, input methods, and abilities."],
	["04", "Performance matters", "Fast, efficient pages that respect people’s time and attention."],
	["05", "Designed for people", "Clear interfaces shaped around real tasks instead of decoration."],
	["06", "No black boxes", "Direct communication, visible progress, and useful handover at every stage."],
];
---

<section class="why" id="why-us">
	<div class="container">
		<div class="why-heading" data-reveal>
			<p class="eyebrow">The difference is in the details</p>
			<h2>Why teams<br /><span>choose us.</span></h2>
		</div>
		<div class="principles" data-reveal-stagger>
			{principles.map(([number, title, description]) => (
				<article>
					<span>{number}</span>
					<div><h3>{title}</h3><p>{description}</p></div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.why { padding: 108px 0; background: var(--surface); }
	.why-heading { display: flex; align-items: end; justify-content: space-between; gap: 26px; margin-bottom: 44px; }
	h2 { margin: 0; font-size: clamp(3.1rem,6vw,5.2rem); line-height: .94; letter-spacing: -.075em; text-transform: uppercase; }
	h2 span { color: var(--accent); }
	.why-heading .eyebrow { margin-bottom: 10px; }
	.principles { display: grid; grid-template-columns: repeat(3,1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
	article { display: grid; min-height: 175px; grid-template-columns: 34px 1fr; gap: 18px; padding: 23px 20px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background 180ms ease; }
	article:hover { background: rgba(139,92,246,.06); }
	article > span { color: var(--cyan); font-size: .7rem; font-weight: 750; }
	h3 { margin: 0 0 8px; font-size: .98rem; letter-spacing: -.02em; }
	article p { margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.7; }
	@media (max-width: 800px) {
		.why { padding: 82px 0; }
		.principles { grid-template-columns: repeat(2,1fr); }
	}
	@media (max-width: 520px) {
		.why-heading { align-items: flex-start; flex-direction: column; }
		.principles { grid-template-columns: 1fr; }
		article { min-height: 0; padding: 20px 16px; }
	}
</style>
