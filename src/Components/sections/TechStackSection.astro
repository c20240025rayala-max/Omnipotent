---
const technologies = ["React", "Next.js", "JavaScript", "TypeScript", "Tailwind CSS", "Node.js", "GSAP", "WordPress"];
---

<section class="technology" id="technology" aria-labelledby="technology-title">
	<div class="container technology-head" data-reveal>
		<div><p class="eyebrow">Tools for the job</p><h2 id="technology-title">Modern tools.<br /><span>Thoughtful use.</span></h2></div>
		<p>We choose technology to fit the problem—not the other way around.</p>
	</div>
	<div class="marquee-viewport" aria-label="Technology stack">
		<div class="stack-track" data-marquee>
			{Array.from({ length: 2 }).map((_, index) => (
				<ul class="stack-group" aria-hidden={index === 1 ? "true" : undefined}>
					{technologies.map((technology) => <li><span aria-hidden="true">✳</span>{technology}</li>)}
				</ul>
			))}
		</div>
	</div>
</section>

<style>
	.technology { overflow: hidden; padding: 92px 0 100px; background: var(--paper); }
	.technology-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 42px; }
	h2 { margin: 0; font-size: clamp(2.8rem,5.4vw,4.7rem); line-height: .96; letter-spacing: -.075em; text-transform: uppercase; }
	h2 span { color: var(--accent); }
	.technology-head > p { max-width: 310px; margin: 0 0 7px; color: var(--muted); font-size: .9rem; line-height: 1.8; }
	.marquee-viewport { width: 100%; overflow: hidden; border-block: 1px solid var(--line); }
	.stack-track { display: flex; width: max-content; }
	.stack-group { display: flex; flex: none; align-items: center; gap: 42px; margin: 0; padding: 22px 21px; list-style: none; }
	.stack-group li { display: flex; align-items: center; gap: 10px; color: #cbd5e1; font-size: .9rem; font-weight: 650; white-space: nowrap; transition: color 180ms ease; }
	.stack-group li:hover { color: white; }
	.stack-group li span { color: #64748b; font-size: 1rem; transition: color 180ms ease; }
	.stack-group li:hover span { color: var(--cyan); }
	@media (max-width: 600px) {
		.technology { padding: 72px 0; }
		.technology-head { align-items: flex-start; flex-direction: column; }
		.stack-group { gap: 25px; padding-inline: 13px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.stack-group[aria-hidden="true"] { display: none; }
	}
</style>
